@prefix conf: <http://conference.eu/vocab/> .
@prefix confS: <http://conference.eu/vocab/shapes/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

confS:AuthorShape  a  sh:NodeShape ;
    sh:targetClass  conf:_______________ ;
    sh:property [
        sh:path  conf:hasAuthorName ;
        sh:minCount 1 ;
        sh:maxCount _______________
    ]  .

confS:ArticleShape  a  sh:NodeShape ;
    sh:targetClass  conf:Presentation ;
    sh:property [
        sh:path  conf:articlePresentation ;
        _______________ 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path  conf:authorPresentation ;
        sh:minCount 1 ;
        sh:maxCount 2
    ]  .

confS:ConferenceShape  a  sh:NodeShape ;
    sh:targetClass  conf:Conference ;
    sh:property [
        sh:path conf:hasConferenceName ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
