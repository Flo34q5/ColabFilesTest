@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix schema: <http://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix conf: <http://conference.eu/vocab/> .

<Presentation>
        rml:logicalSource [ rml:source "/data/sources/exercise/Presentation.csv";
                _______________
                ];
    rr:subjectMap [
        rr:template "http://conference.eu/entity/{AuthorID}_{ConferenceID}_{ArticleID}";
        rr:class conf:Presentation
    ];
    rr:predicateObjectMap [
        rr:predicate conf:authorPresentation;
        rr:objectMap [
        rr:template "http://conference.eu/entity/{AuthorID}";
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate conf:conferencePresentation;
        rr:objectMap [
        rr:template "http://conference.eu/entity/{ConferenceID}";
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate conf:articlePresentation;
        rr:objectMap [
        _______________;
        ]
    ].
