@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix schema: <http://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix conf: <http://conference.eu/vocab/> .

<Conference_Center>
       _______________ [ rml:source "/data/sources/exercise/Conference_Center.csv";
                rml:referenceFormulation ql:CSV
                ];
    rr:subjectMap [
        rr:template "http://conference.eu/entity/{Conf_CenterID}";
        rr:class conf:ConfCenter
    ];
      rr:predicateObjectMap [
        rr:predicate conf:Address;
        rr:objectMap [
        _______________
	rr:datatype xsd:string;
        ]];
      
rr:predicateObjectMap [
		rr:predicate conf:hosts;
		rr:objectMap [
			rr:parentTriplesMap <Conference>;
                            rr:joinCondition [
                                    rr:child "ConferenceID";
                                    rr:parent "ConferenceID";]]].


<Conference>
       _______________ [ rml:source "/data/sources/exercise/Conference.csv";
                rml:referenceFormulation ql:CSV
                ];
    rr:subjectMap [
        rr:template "http://conference.eu/entity/{ConferenceID}";
        rr:class conf:Conference
    ];
    rr:predicateObjectMap [
        rr:predicate conf:hasConferenceName;
        rr:objectMap [
          rml:reference "Conference_name" ;
          _______________
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate conf:hasYear;
        rr:objectMap [
        rml:reference "Year";
        rr:datatype xsd:date
        ] ].
