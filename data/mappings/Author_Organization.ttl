@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix schema: <http://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix conf: <http://conference.eu/vocab/> .

<Author>
       rml:logicalSource [ rml:source "/data/sources/exercise/Author.csv";
                rml:referenceFormulation ql:CSV
                ];

  rr:subjectMap [
        rr:template "http://conference.eu/entity/{AuthorID}";
        rr:class conf:Author
    ];
 rr:predicateObjectMap [
        rr:predicate conf:hasAuthorName;
        rr:objectMap [
        rml:reference "Author_name";
            rr:datatype xsd:string;
        ]];
 rr:predicateObjectMap [
        rr:predicate conf:hasPhone_number;
        rr:objectMap [
        rml:reference "Phone_number";
			rr:datatype xsd:int;
        ]];

rr:predicateObjectMap [
		rr:predicate conf:hasAffiliation;
		rr:objectMap [
			rr:parentTriplesMap <Organization>;
                            rr:joinCondition [
                                    rr:child "OrganizationID";
                                    rr:parent "OrganizationID";]]].

<Organization>
       rml:logicalSource [ rml:source "/data/sources/exercise/Organization.csv";
                rml:referenceFormulation ql:CSV
                ];
    rr:subjectMap [
        rr:template "http://conference.eu/entity/{OrganizationID}";
        rr:class conf:Organization
    ];
    rr:predicateObjectMap [
        rr:predicate conf:hasOrganizationName;
        rr:objectMap [
        rml:reference "Organization_name";
			rr:datatype xsd:string;
        ]
    ];
    rr:predicateObjectMap [
        rr:predicate conf:hasCountry;
        rr:objectMap [
        rr:template "http://conference.eu/entity/{Country}";
        ]
    ].
