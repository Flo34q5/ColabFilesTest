@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix schema: <http://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix conf: <http://conference.eu/vocab/> .

<Article_Keywords>
       rml:logicalSource [ rml:source "/data/sources/exercise/Article_Keywords.csv";
                rml:referenceFormulation ql:CSV
                ];
    rr:subjectMap [
        rr:template "http://conference.eu/entity/{ArticleID}";
        rr:class conf:Article
    ];
    rr:predicateObjectMap [
        rr:predicate conf:hasKeyword;
        rr:objectMap [
        rml:reference "Keyword";
        ]
    ].
